# ─────────────────────────────────────────────────────────────
# Veritas AI — configuration serveur
# Aucune clé d'API tierce n'est requise : le moteur est 100 % local.
# ─────────────────────────────────────────────────────────────

# Serveur
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Origines autorisées pour le CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,chrome-extension://*

# Stockage local (JSON chiffré au repos)
DATA_DIR=.data
# Clé de chiffrement des analyses au repos (32 octets en base64).
# Laisser vide en dev => une clé est générée et stockée dans DATA_DIR/.key
ENCRYPTION_KEY=

# Récupération des annonces
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5242880
FETCH_USER_AGENT=VeritasAI/0.1 (+https://veritas.local)
# Respecter robots.txt lors de la récupération d'une URL
RESPECT_ROBOTS=true

# Limitation de débit
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# Surveillance des annonces (alertes)
WATCH_ENABLED=true
WATCH_INTERVAL_MS=1800000

# Cerveau conversationnel : "local" (par défaut, aucun réseau)
# ou "ollama" pour brancher un modèle local auto-hébergé.
BRAIN_DRIVER=local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
